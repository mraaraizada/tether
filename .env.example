# ── Model provider ────────────────────────────────────────────────────────────
# Leave everything unset to run in deterministic "extractive" mode: retrieval
# and verbatim passages only, nothing is generated.
#
# Pick ONE of the two options below.

# Option A — any OpenAI-compatible endpoint (OpenRouter, Ollama, LM Studio,
# vLLM, Groq, Together). Recommended open model: GPT-OSS.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-...
OPENAI_MODEL=openai/gpt-oss-120b

# Fully local instead (no key, no network — needs `ollama serve`):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=gpt-oss:20b

# Option B — Claude via the Anthropic API.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# Force a provider instead of auto-detecting: anthropic | openai | none
# MODEL_PROVIDER=openai

# How long to wait for one model response (ms). Local models need the headroom.
# MODEL_TIMEOUT_MS=300000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Max /api/ask requests per IP per minute.
ASK_RATE_LIMIT=20

# Where the case pack and the response cache live (default: repo root).
# DATA_DIR=./data
# CACHE_DIR=./.cache
